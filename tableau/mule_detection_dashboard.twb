      <aliases enabled='yes' />
      <column caption='Burst Bucket' datatype='string' name='[Calculation_0225738720186368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [burst_score] &gt;= 4 THEN &quot;Burst 4+&quot;&#13;&#10;ELSEIF [burst_score] &gt;= 2 THEN &quot;Burst 2-3&quot;&#13;&#10;ELSE &quot;Burst 1&quot;&#13;&#10;END' />
      </column>
      <column caption='Z-Score Bucket' datatype='string' name='[Calculation_0225738720407553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([amount_z_score]) &gt; 2 THEN &quot;Z &gt; 2&quot;&#13;&#10;ELSEIF ABS([amount_z_score]) &gt; 1 THEN &quot;Z 1-2&quot;&#13;&#10;ELSE &quot;Z &lt; 1&quot;&#13;&#10;END' />
      </column>
      <column caption='Mule Rate %' datatype='real' name='[Calculation_0225738720907268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_mule_tx] = TRUE THEN 1 ELSE 0 END) / COUNT([transaction_id])' />
      </column>
      <column caption='High Risk Flag' datatype='boolean' name='[Calculation_0497318159654924]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[burst_score] &gt;= 2 &#13;&#10;AND [dwell_time_minutes] &lt; 5 &#13;&#10;AND [is_first_time_payee] = TRUE' />
        <aliases>
          <alias key='false' value='Did NOT trigger rule' />
          <alias key='true' value='Triggered rule' />
        </aliases>
      </column>
      <column caption='Dwell Time Bin' datatype='string' name='[Calculation_0497318161854477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dwell_time_minutes] &lt; 0 THEN &quot;N/A&quot;&#13;&#10;ELSEIF [dwell_time_minutes] &lt; 5 THEN &quot;&lt; 5 Min&quot;&#13;&#10;ELSEIF [dwell_time_minutes] &lt; 15 THEN &quot;5-15 Min&quot;&#13;&#10;ELSEIF [dwell_time_minutes] &lt; 60 THEN &quot;15-60 Min&quot;&#13;&#10;ELSE &quot;&gt; 1 Hour&quot;&#13;&#10;END' />
      </column>
      <column caption='Imbalance %' datatype='real' name='[Calculation_0800508659605504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transaction_id]) / TOTAL(COUNT([transaction_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
