    <worksheet name='compound_rule'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='24'><![CDATA[Compound Rule: Burst ≥ 2 + Dwell < 5 min + First-Time Payee]]></run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='18'>Transactions </run>
            <run bold='true' fontsize='18'>triggering all 3</run>
            <run fontsize='18'> conditions have </run>
            <run bold='true' fontsize='18'>88.9% mule rate</run>
            <run fontsize='18'> — a </run>
            <run bold='true' fontsize='18'>56x lift over baseline</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000'>Rule:</run>
            <run fontcolor='#000000'><![CDATA[ IF burst_score ≥ 2 AND dwell_time < 5 min AND is_first_time_payee = True → FLAG FOR REVIEW]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ver_2_data_final)' name='federated.0z4vlt40aarhbj16fod7o0k8uxvx' />
          </datasources>
          <datasource-dependencies datasource='federated.0z4vlt40aarhbj16fod7o0k8uxvx'>
            <column caption='Mule Rate %' datatype='real' name='[Calculation_0225738720907268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_mule_tx] = TRUE THEN 1 ELSE 0 END) / COUNT([transaction_id])' />
            </column>
            <column caption='High Risk Flag' datatype='boolean' name='[Calculation_0497318159654924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[burst_score] &gt;= 2 &#13;&#10;AND [dwell_time_minutes] &lt; 20 &#13;&#10;AND [is_first_time_payee] = TRUE' />
              <aliases>
                <alias key='false' value='Did NOT triggered rule' />
                <alias key='true' value='Triggered rule' />
              </aliases>
            </column>
            <column caption='Burst Score' datatype='integer' name='[burst_score]' role='measure' type='quantitative' />
            <column-instance column='[transaction_id]' derivation='Count' name='[cnt:transaction_id:qk]' pivot='key' type='quantitative' />
            <column caption='Dwell Time Minutes' datatype='real' name='[dwell_time_minutes]' role='measure' type='quantitative' />
            <column caption='Is First Time Payee' datatype='boolean' name='[is_first_time_payee]' role='dimension' type='nominal' />
            <column caption='Is Mule Tx' datatype='boolean' name='[is_mule_tx]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Normal' />
                <alias key='true' value='Mule' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0497318159654924]' derivation='None' name='[none:Calculation_0497318159654924:nk]' pivot='key' type='nominal' />
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0225738720907268]' derivation='User' name='[usr:Calculation_0225738720907268:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
