            </column-instance>
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='width' field='[federated.0z4vlt40aarhbj16fod7o0k8uxvx].[pcto:cnt:transaction_id:qk:5]' value='158' />
