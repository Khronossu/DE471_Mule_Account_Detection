    <worksheet name='Normalized Bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='24'>Burst Score Distribution: Mule vs Normal Accounts</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='18'>28.6%</run>
            <run fontsize='18'>Æ </run>
            <run bold='true' fontsize='18'>of mule</run>
            <run fontsize='18'> transactions </run>
            <run bold='true' fontsize='18'>are</run>
            <run fontsize='18'>Æ </run>
            <run bold='true' fontsize='18'>Burst 2-3</run>
            <run fontsize='18'> — vs only </run>
            <run bold='true' fontsize='18'>0.47%</run>
            <run fontsize='18'>Æ </run>
            <run bold='true' fontsize='18'>of normal accounts</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' italic='true'>Burst Score</run>
            <run fontcolor='#000000' italic='true'> = number of outgoing transfers in the last 1 hour | Burst 1 = 1 transfer/hr (normal pace) | Burst 2-3 = 2–3 transfers/hr (rapid fire)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ver_2_data_final)' name='federated.0z4vlt40aarhbj16fod7o0k8uxvx' />
          </datasources>
          <datasource-dependencies datasource='federated.0z4vlt40aarhbj16fod7o0k8uxvx'>
            <column caption='Burst Bucket' datatype='string' name='[burst_bucket]' role='dimension' type='nominal' />
            <column caption='Is Mule Tx' datatype='boolean' name='[is_mule_tx]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Normal' />
                <alias key='true' value='Mule' />
              </aliases>
            </column>
            <column-instance column='[burst_bucket]' derivation='None' name='[none:burst_bucket:nk]' pivot='key' type='nominal' />
