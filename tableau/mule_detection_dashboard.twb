    <worksheet name='Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='24'>Mule Rate by Burst Score × Amount Z-Score</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='18'>Burst 2-3 drives 33.6% mule rate</run>
            <run fontsize='18'> — amount size is not the signal</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000'>Burst Score</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#000000' italic='true'>number of outgoing transfers in the last 1 hour</run>
            <run fontcolor='#000000'>  |  </run>
            <run bold='true' fontcolor='#000000'>Z-Score</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#000000' italic='true'>how unusual the transfer amount is vs sender&apos;s history</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ver_2_data_final)' name='federated.0z4vlt40aarhbj16fod7o0k8uxvx' />
          </datasources>
          <datasource-dependencies datasource='federated.0z4vlt40aarhbj16fod7o0k8uxvx'>
            <column caption='Z-Score Bucket' datatype='string' name='[Calculation_0225738720407553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ABS([amount_z_score]) &gt; 2 THEN &quot;Z &gt; 2&quot;&#13;&#10;ELSEIF ABS([amount_z_score]) &gt; 1 THEN &quot;Z 1-2&quot;&#13;&#10;ELSE &quot;Z &lt; 1&quot;&#13;&#10;END' />
            </column>
            <column caption='Mule Rate %' datatype='real' name='[Calculation_0225738720907268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_mule_tx] = TRUE THEN 1 ELSE 0 END) / COUNT([transaction_id])' />
            </column>
            <column caption='Amount Z Score' datatype='real' name='[amount_z_score]' role='measure' type='quantitative' />
            <column caption='Burst Bucket' datatype='string' name='[burst_bucket]' role='dimension' type='nominal' />
            <column-instance column='[transaction_id]' derivation='Count' name='[cnt:transaction_id:qk]' pivot='key' type='quantitative' />
            <column caption='Is Mule Tx' datatype='boolean' name='[is_mule_tx]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Normal' />
                <alias key='true' value='Mule' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0225738720407553]' derivation='None' name='[none:Calculation_0225738720407553:nk]' pivot='key' type='nominal' />
            <column-instance column='[burst_bucket]' derivation='None' name='[none:burst_bucket:nk]' pivot='key' type='nominal' />
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0225738720907268]' derivation='User' name='[usr:Calculation_0225738720907268:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
